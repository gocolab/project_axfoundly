# 환경 변수 예시 (도커 환경: host.docker.internal)
MONGODB_URI=mongodb://host.docker.internal:27017
MONGODB_DBNAME=launch_bizs_dev

GEMINI_API_KEY=your-gemini-api-key-here

GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret-here
GOOGLE_REDIRECT_URI=http://localhost:3005/api/auth/google/callback

ALLOWED_ORIGINS=*

# JWT 설정
JWT_SECRET_KEY=test-your-secret-key-change-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=12360
API_KEY=your-secure-api-key-123
NEXT_PUBLIC_API_KEY=your-secure-api-key-123

# Playwright visible
HEADED=true

# Kakao Pay
KAKAO_PAY_CID=TC0ONETIME
KAKAO_PAY_SECRET_KEY=your-kakao-pay-secret-key-here
NEXT_PUBLIC_BASE_URL=http://localhost:3005

# Auth & Demo Settings (운영 환경: false 권장, 개발 환경: true)
VITE_SHOW_DEMO_LOGIN=true