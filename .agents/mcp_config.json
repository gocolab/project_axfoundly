{
  "mcpServers": {
    "playwright": {
      "command": "npx",
      "args": [
        "-y",
        "@playwright/mcp-server@latest"
      ],
      "env": {
        "PLAYWRIGHT_HEADLESS": "true"
      }
    },
    "mongodb": {
      "command": "npx",
      "args": [
        "-y",
        "mongodb-mcp-server"
      ],
      "env": {
        "MDB_MCP_CONNECTION_STRING": "mongodb://host.docker.internal:27017/launch_bizs_dev",
        "MONGODB_URI": "mongodb://host.docker.internal:27017",
        "MONGODB_DBNAME": "launch_bizs_dev"
      }
    }
  }
}
