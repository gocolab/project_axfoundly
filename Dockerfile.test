# ==============================================================================
# Playwright 기반 프론트엔드 E2E 및 이상 감지 테스트 Dockerfile
# ==============================================================================
FROM mcr.microsoft.com/playwright:v1.49.0-noble

# 1. 한글 폰트(CJK) 및 가상 디스플레이(Xvfb), 한국 타임존 설치
# - CJK 폰트 미설치 시 스크린샷 비교 및 HTML 텍스트 검증에서 글자 깨짐(ㅁㅁㅁ) 방지
ENV DEBIAN_FRONTEND=noninteractive
ENV TZ=Asia/Seoul

RUN apt-get update && apt-get install -y --no-install-recommends \
    fonts-nanum \
    fonts-nanum-coding \
    fonts-noto-cjk \
    xvfb \
    tzdata \
    && rm -rf /var/lib/apt/lists/*

# 2. 작업 디렉터리 설정
WORKDIR /app

# 3. 의존성 파일 복사 및 설치 (Docker 캐싱 최적화)
COPY package*.json ./
RUN npm ci

# 4. 프로젝트 소스코드 복사
COPY . .

# 5. 브라우저 및 시스템 라이브러리 최종 확인
RUN npx playwright install-deps chromium

# 6. 테스트 결과 및 아티팩트 디렉터리 생성
RUN mkdir -p test-results playwright-report

# 7. 기본 환경 변수
ENV CI=true
ENV PORT=3005
ENV PLAYWRIGHT_AUTH_METHOD=mock

# 8. 컨테이너 기본 실행 명령 (이상 감지 및 E2E 테스트 전체 실행)
CMD ["npm", "run", "test:e2e"]
