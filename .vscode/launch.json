{
  "version": "0.2.0",
  "configurations": [
    {
      "type": "node",
      "request": "launch",
      "name": "🚀 Debug Server (Node.js / tsx)",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "tsx",
        "server.ts"
      ],
      "skipFiles": [
        "<node_internals>/**"
      ],
      "console": "integratedTerminal",
      "restart": true,
      "env": {
        "NODE_ENV": "development"
      }
    },
    {
      "type": "chrome",
      "request": "launch",
      "name": "🌐 Launch Chrome (Frontend)",
      "url": "http://localhost:3000",
      "webRoot": "${workspaceFolder}",
      "sourceMaps": true
    },
    {
      "type": "chrome",
      "request": "attach",
      "name": "🔗 Attach to Chrome",
      "port": 9222,
      "webRoot": "${workspaceFolder}"
    }
  ],
  "compounds": [
    {
      "name": "⚡ Fullstack Debug (Server + Chrome)",
      "configurations": [
        "🚀 Debug Server (Node.js / tsx)",
        "🌐 Launch Chrome (Frontend)"
      ],
      "stopAll": true
    }
  ]
}
